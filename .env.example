# ── Arcana Hold'em — environment variables ──────────────────────────────────
# Copy to .env and populate after running:
#   anchor build && anchor deploy --provider.cluster devnet
#   arcium register-mxe --cluster devnet
#   arcium info --cluster devnet

# Your deployed program ID (from anchor deploy output).
# Replace with the program ID printed by `anchor deploy`:
VITE_PROGRAM_ID=Fg6PaFpoGXkYsidMpWTK6W2BeZ7FEfcYkg476zPFsLnS

# Arcium on-chain program (same across all devnet deployments).
VITE_ARCIUM_PROGRAM_ID=

# Your MXE account address (from arcium register-mxe output).
VITE_ARCIUM_MXE_PUBKEY=

# PDAs derived from the MXE (from arcium info --cluster devnet).
VITE_ARCIUM_MEMPOOL_PUBKEY=
VITE_ARCIUM_EXECPOOL_PUBKEY=
VITE_ARCIUM_CLUSTER_PUBKEY=
VITE_ARCIUM_COMP_DEF_PUBKEY=

# Fixed Arcium protocol fee accounts (same on all devnet deployments).
VITE_ARCIUM_FEE_POOL_PUBKEY=
VITE_ARCIUM_CLOCK_PUBKEY=

# Optional: paste the 64-char hex of the cluster X25519 pubkey here to skip
# the on-chain fetch (printed by "arcium info --cluster devnet").
VITE_ARCIUM_CLUSTER_X25519_PUBKEY_HEX=

# Solana RPC endpoint.
# Recommended: use a Helius free RPC (create account at helius.dev) for reliability.
# VITE_SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=<YOUR_HELIUS_KEY>
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
